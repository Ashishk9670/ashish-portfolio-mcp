# agents' peer dependencies pull in a real conflict: partyserver (a transitive
# dependency of agents) requires @cloudflare/workers-types ^4, while a recent
# wrangler wants ^5 as an (optional) peer — and separately, agents declares
# react as a required peer for its optional React-hooks entrypoint, which
# this project doesn't use and has no reason to install. Committed so local
# installs and CI's `npm ci` resolve the same way without extra flags.
legacy-peer-deps=true
