    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.129.0"
  }
