  "private": true,
  "type": "module",
  "bin": {
    "ashish-portfolio-mcp": "./bin/stdio.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
